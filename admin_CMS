   (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
   m[i].l=1*new Date();
   for (var j=0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
   k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
   (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
   ym(99999999, "init", {
        clickmap:true,
        trackLinks:true,
        accurateTrackBounce:true,
        webvisor:true
   });
</script> -->
`,
                                    // Упрощенное хранение отзывов как JSON
                                    testimonials_json: `[
    {"quote": "Тренажер дал уверенность, которой не хватало после курсов...", "author": "Анатолий К.", "role": "Трафик-менеджер (фриланс)"},
    {"quote": "Самое ценное — это разбор переговоров...", "author": "Марина С.", "role": "Маркетолог-аналитик"}
]`,
                                };
                                setCmsData(defaultData);
                                window.setDoc(docRef, defaultData).catch(e => console.error("Error setting default data:", e));
                            }
                            setIsLoading(false);
                        }, (error) => {
                            console.error("Firestore subscription error:", error);
                            setIsLoading(false);
                        });

                        return () => unsubscribe();
                    }
                };

                if (window.isFirebaseReady) {
                    initFirebase();
                } else {
                    document.addEventListener('firebaseReady', initFirebase);
                    return () => document.removeEventListener('firebaseReady', initFirebase);
                }
            }, [isFirebaseReady]);
            
            // Функция сохранения данных в Firestore
            const handleSave = useCallback(async () => {
                if (!window.db || !window.appId) {
                    setNotification({ message: 'Ошибка: База данных не инициализирована.', type: 'error' });
                    return;
                }
                
                setIsSaving(true);
                setNotification({ message: '', type: '' });

                // Проверка JSON-полей перед сохранением
                try {
                    JSON.parse(cmsData.testimonials_json);
                } catch (e) {
                    setNotification({ message: 'Ошибка сохранения: Некорректный JSON в поле Отзывов.', type: 'error' });
                    setIsSaving(false);
                    return;
                }
                
                try {
                    const docRef = window.doc(window.db, getFirestorePath(window.appId));
                    await window.setDoc(docRef, cmsData);
                    setNotification({ message: 'Контент успешно обновлен!', type: 'success' });
                } catch (e) {
                    console.error("Error saving document: ", e);
                    setNotification({ message: `Ошибка сохранения: ${e.message}`, type: 'error' });
                } finally {
                    setIsSaving(false);
                    setTimeout(() => setNotification({ message: '', type: '' }), 5000);
                }
            }, [cmsData]);
            
            // Рендеринг основной секции
            const renderContent = () => {
                switch (activeSection) {
                    case 'cms':
                        return <ContentEditor data={cmsData} setData={setCmsData} onSave={handleSave} isLoading={isLoading} isSaving={isSaving} />;
                    case 'seo':
                        return <SeoEditor data={cmsData} setData={setCmsData} onSave={handleSave} isLoading={isLoading} isSaving={isSaving} />;
                    case 'analytics':
                        return <AnalyticsDashboard isLoading={isLoading} />;
                    case 'users':
                        return (
                            <div className="bg-[#1A1D24] p-8 rounded-2xl border border-white/10 min-h-[400px]">
                                <h2 className="text-3xl font-bold text-white mb-6">Управление пользователями админки (WIP)</h2>
                                <p className="text-slate-400">
                                    Этот функционал требует полноценного бэкенда с системами регистрации, ролей и аутентификации.
                                    Текущая версия использует анонимный вход.
                                </p>
                                <p className="text-slate-300 mt-4">
                                    <span className="font-bold text-[#C5F82A]">Ваша роль:</span> Главный Администратор (Владелец)
                                </p>
                            </div>
                        );
                    default:
                        return <p className="text-white">Выберите раздел в меню.</p>;
                }
            };

            const NavItem = ({ section, icon: Icon, label }) => (
                <button
                    onClick={() => setActiveSection(section)}
                    className={`flex items-center gap-3 w-full p-3 rounded-xl transition-colors ${
                        activeSection === section
                            ? 'bg-[#C5F82A] text-black font-bold'
                            : 'text-slate-300 hover:bg-white/5'
                    }`}
                >
                    <Icon size={20} className={activeSection === section ? 'text-black' : 'text-slate-400'} />
                    <span>{label}</span>
                </button>
            );

            return (
                <div className="min-h-screen flex bg-[#0B0C10]">
                    <Notification message={notification.message} type={notification.type} />
                    
                    {/* Боковое меню */}
                    <div className="w-64 bg-[#16181D] p-6 border-r border-white/5 fixed h-full">
                        <h1 className="text-2xl font-extrabold text-[#C5F82A] tracking-wider mb-8">
                            Admin CMS
                        </h1>
                        <nav className="space-y-2">
                            <NavItem section="cms" icon={LayoutIcon} label="Контент (CMS)" />
                            <NavItem section="seo" icon={SettingsIcon} label="SEO & Код" />
                            <NavItem section="analytics" icon={BarChart3Icon} label="Аналитика (Mock)" />
                            <NavItem section="users" icon={UserIcon} label="Пользователи" />
                        </nav>
                        
                        <div className="mt-8 pt-4 border-t border-white/5">
                            <p className="text-xs text-slate-500">
                                Пользователь ID: <br/> 
                                <span className="font-mono break-all text-slate-300 text-[10px]">{window.auth?.currentUser?.uid || 'Loading...'}</span>
                            </p>
                        </div>
                    </div>

                    {/* Основная рабочая область */}
                    <main className="flex-1 p-8 md:p-12 ml-64">
                        <div className="max-w-4xl mx-auto bg-[#0B0C10] p-6 rounded-2xl">
                            {renderContent()}
                        </div>
                    </main>
                </div>
            );
        }

        ReactDOM.render(<App />, rootElement);
    </script>
</body>
</html>
